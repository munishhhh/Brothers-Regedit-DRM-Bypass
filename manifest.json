{
  "manifest_version": 3,
  "name": "Brothers Regedit DRM Bypass",
  "version": "1.3",
  "homepage_url": "https://github.com/munishhhh/Brothers-Regedit-DRM-Bypass",
  "description": "Prevents black screen on Discord ScreenShare for all OTT platforms (JioHotstar, Hotstar, JioCinema, Netflix, Prime Video, SonyLIV, Zee5, Crunchyroll & more)",
  "icons": {
    "128": "icon.png"
  },
  "permissions": [
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "128": "icon.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "injected.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    }
  ]
}